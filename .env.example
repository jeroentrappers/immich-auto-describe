# Copy to .env and fill in. docker-compose reads these.
IMMICH_API_KEY=change-me
DEFAULT_LANG=en

# Only needed if a PROVIDERS entry uses "api_key_env":"OPENROUTER_API_KEY"
OPENROUTER_API_KEY=

# Providers are set in docker-compose.yml (PROVIDERS). Local example uses
# host.docker.internal:1234 (an OpenAI-compatible server on the host).
